[Unit]
Description=ReefBerry reef dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reefberry
Group=reefberry
Environment=REEFBERRY_DATA_DIR=/var/lib/reefberry
Environment=REEFBERRY_PORT=80
ExecStart=/opt/reefberry/venv/bin/reefberry
Restart=on-failure
RestartSec=5

# Allow port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: the app can only write to its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/reefberry

[Install]
WantedBy=multi-user.target
